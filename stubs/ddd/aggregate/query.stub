<?php

declare(strict_types=1);

namespace Modules\{{ module }}\Queries;

use App\Modules\IndexQuery;
use Illuminate\Database\Eloquent\Builder;
use Modules\{{ module }}\Infrastructure\Models\{{ aggregate }};
use Spatie\QueryBuilder\AllowedFilter;
use Spatie\QueryBuilder\QueryBuilder;

/**
 * @extends IndexQuery<{{ aggregate }}>
 */
final readonly class {{ plural }}IndexQuery extends IndexQuery
{
    /**
     * @return QueryBuilder<{{ aggregate }}>
     */
    public function query(): QueryBuilder
    {
        return QueryBuilder::for({{ aggregate }}::class, $this->request)
            ->allowedFilters(
                AllowedFilter::callback('search', $this->search(...)),
            )
            ->allowedSorts('name', 'created_at')
            ->defaultSort('-created_at');
    }

    /**
     * @param  Builder<{{ aggregate }}>  $query
     */
    private function search(Builder $query, mixed $value): void
    {
        $search = implode(',', $this->stringValues($value));

        $query->whereLike('name', '%'.$search.'%');
    }
}
