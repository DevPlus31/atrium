<?php

declare(strict_types=1);

namespace Modules\{{ module }}\Queries;

use Illuminate\Database\Eloquent\Builder;
use Illuminate\Http\Request;
use Illuminate\Pagination\LengthAwarePaginator;
use Illuminate\Support\Arr;
use Modules\{{ module }}\Infrastructure\Models\{{ aggregate }};
use Spatie\QueryBuilder\AllowedFilter;
use Spatie\QueryBuilder\QueryBuilder;

final readonly class {{ plural }}IndexQuery
{
    private const int DEFAULT_PER_PAGE = 15;

    private const int MAX_PER_PAGE = 100;

    public function __construct(private Request $request)
    {
        //
    }

    /**
     * @return QueryBuilder<{{ aggregate }}>
     */
    public function builder(): QueryBuilder
    {
        return QueryBuilder::for({{ aggregate }}::class, $this->request)
            ->allowedFilters(
                AllowedFilter::callback('search', $this->search(...)),
            )
            ->allowedSorts('name', 'created_at')
            ->defaultSort('-created_at');
    }

    /**
     * @return LengthAwarePaginator<int, {{ aggregate }}>
     */
    public function paginate(): LengthAwarePaginator
    {
        return $this->builder()
            ->paginate($this->perPage())
            ->appends($this->request->query());
    }

    /**
     * @param  Builder<{{ aggregate }}>  $query
     */
    private function search(Builder $query, mixed $value): void
    {
        $search = implode(',', $this->stringValues($value));

        $query->where('name', 'like', '%'.$search.'%');
    }

    /**
     * @return list<string>
     */
    private function stringValues(mixed $value): array
    {
        $values = [];

        foreach (Arr::wrap($value) as $entry) {
            if (is_scalar($entry)) {
                $values[] = (string) $entry;
            }
        }

        return $values;
    }

    private function perPage(): int
    {
        $perPage = $this->request->integer('per_page', self::DEFAULT_PER_PAGE);

        return min(max($perPage, 1), self::MAX_PER_PAGE);
    }
}
