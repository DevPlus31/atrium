import { Head } from '@inertiajs/react';
import { useLaravelReactI18n } from 'laravel-react-i18n';
import {
    DataTable,
    DataTableCreateButton,
    DataTableDeleteDialog,
    DataTableToolbar,
} from '@/components/data-table';
import { useBreadcrumbs } from '@/hooks/use-breadcrumbs';
import { useFormatters } from '@/hooks/use-formatters';
import { useResourceTable } from '@/hooks/use-resource-table';
import { create, destroy, index } from '@/routes/admin/{{ slug }}';
import type { Paginated } from '@/types/admin';
import type { {{ aggregate }}Row } from '../components/{{ aggregateKebab }}-columns';
import { build{{ aggregate }}Columns } from '../components/{{ aggregateKebab }}-columns';

type {{ plural }}IndexProps = {
    {{ variablePlural }}: Paginated<{{ aggregate }}Row>;
    can: { create: boolean };
};

export default function {{ plural }}Index({ {{ variablePlural }}, can }: {{ plural }}IndexProps) {
    const { t } = useLaravelReactI18n();
    const format = useFormatters();
    const { tableState, deleteDialog } = useResourceTable({
        key: '{{ slug }}',
        rows: {{ variablePlural }}.data,
        destroyUrl: (row) => destroy.url(row.id),
    });

    useBreadcrumbs({ title: t('{{ label }}'), href: index() });

    const columns = build{{ aggregate }}Columns(t, format, deleteDialog.request);

    return (
        <>
            <Head title={t('{{ label }}')} />
            <DataTableToolbar
                tableState={tableState}
                searchPlaceholder={t('Search {{ slug }}...')}
                actions={
                    can.create && (
                        <DataTableCreateButton
                            href={create()}
                            label={t('Create {{ variable }}')}
                        />
                    )
                }
            />
            <DataTable
                columns={columns}
                paginated={{{ variablePlural }}}
                tableState={tableState}
                emptyMessage={t('No {{ slug }} found.')}
            />
            <DataTableDeleteDialog
                dialog={deleteDialog}
                title={t('Delete {{ variable }}')}
                name={(row) => row.name}
                fallbackName={t('this {{ variable }}')}
            />
        </>
    );
}
