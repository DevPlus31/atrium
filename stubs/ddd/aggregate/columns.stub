import {
    actionsColumn,
    dateColumn,
    sortableColumn,
    DeleteMenuItem,
    EditMenuItem,
    type DataTableColumn,
} from '@/components/data-table';
import type { Formatters } from '@/lib/format';
import { edit } from '@/routes/admin/{{ slug }}';
import type { Translator } from '@/types/ui';

export type {{ aggregate }}Row = Modules.{{ module }}.Data.{{ aggregate }}Data;

export function build{{ aggregate }}Columns(
    t: Translator,
    format: Formatters,
    onDelete: (item: {{ aggregate }}Row) => void,
): DataTableColumn<{{ aggregate }}Row>[] {
    return [
        sortableColumn<{{ aggregate }}Row>({
            id: 'name',
            title: t('Name'),
            cell: (row) => (
                <span className="font-medium">{row.name}</span>
            ),
        }),
        dateColumn<{{ aggregate }}Row>({
            id: 'created_at',
            title: t('Created'),
            value: (item) => item.created_at,
            format: format.date,
        }),
        actionsColumn<{{ aggregate }}Row>({
            label: t('Actions'),
            visible: (item) => item.can.update || item.can.delete,
            items: (item) => (
                <>
                    {item.can.update && <EditMenuItem href={edit(item.id)} />}
                    {item.can.delete && (
                        <DeleteMenuItem onSelect={() => onDelete(item)} />
                    )}
                </>
            ),
        }),
    ];
}
