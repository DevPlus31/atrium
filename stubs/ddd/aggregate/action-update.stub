<?php

declare(strict_types=1);

namespace Modules\{{ module }}\Actions;

use App\Modules\AuditLog;
use Illuminate\Support\Facades\DB;
use Modules\{{ module }}\Domain\Repositories\{{ aggregate }}Repository;
use Modules\{{ module }}\Infrastructure\Models\{{ aggregate }};

final readonly class Update{{ aggregate }}
{
    public function __construct(private {{ aggregate }}Repository ${{ variablePlural }})
    {
        //
    }

    public function handle({{ aggregate }} ${{ variable }}, string $name, ?string $description): {{ aggregate }}
    {
        return DB::transaction(function () use (${{ variable }}, $name, $description): {{ aggregate }} {
            ${{ variable }} = $this->{{ variablePlural }}->lockForUpdate(${{ variable }});
            ${{ variable }}->fill([
                'name' => $name,
                'description' => $description,
            ]);

            $this->{{ variablePlural }}->save(${{ variable }});

            AuditLog::record(
                log: '{{ slug }}',
                event: 'updated',
                subject: ${{ variable }},
                properties: [
                    'attributes' => ['name' => $name],
                ],
            );

            return ${{ variable }};
        });
    }
}
