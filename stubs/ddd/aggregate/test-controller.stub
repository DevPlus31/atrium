<?php

declare(strict_types=1);

use App\Models\User;
use App\Modules\NavRegistry;
use Modules\{{ module }}\Infrastructure\Models\{{ aggregate }};
use Spatie\Permission\Models\Role;

beforeEach(function (): void {
    $this->withoutVite();

    $this->artisan('admin:sync-permissions')->assertSuccessful();
});

function {{ variable }}ModuleAdmin(): User
{
    $user = User::factory()->create();
    $user->assignRole('admin');

    return $user;
}

it('redirects guests to the login page', function (string $method, string $uri): void {
    $this->{$method}($uri)->assertRedirectToRoute('login');
})->with([
    'index' => ['get', '/admin/{{ slug }}'],
    'create' => ['get', '/admin/{{ slug }}/create'],
    'store' => ['post', '/admin/{{ slug }}'],
    'edit' => ['get', '/admin/{{ slug }}/00000000-0000-0000-0000-000000000000/edit'],
    'update' => ['put', '/admin/{{ slug }}/00000000-0000-0000-0000-000000000000'],
    'destroy' => ['delete', '/admin/{{ slug }}/00000000-0000-0000-0000-000000000000'],
]);

it('forbids authenticated users without the admin role', function (): void {
    $this->actingAs(User::factory()->create())->get('/admin/{{ slug }}')->assertForbidden();
});

it('forbids admins without the {{ slug }}.view permission', function (): void {
    Role::findByName('admin')->revokePermissionTo('{{ slug }}.view');

    $this->actingAs({{ variable }}ModuleAdmin())->get(route('admin.{{ slug }}.index'))->assertForbidden();
});

it('registers the nav item for permitted admins and hides it otherwise', function (): void {
    $registry = $this->app->make(NavRegistry::class);

    $adminItems = $registry->itemsFor({{ variable }}ModuleAdmin());
    $guestItems = $registry->itemsFor(User::factory()->create());

    expect(collect($adminItems)->firstWhere('label', '{{ label }}'))->not->toBeNull()
        ->and(collect($guestItems)->firstWhere('label', '{{ label }}'))->toBeNull();
});

it('renders the index with per-row abilities', function (): void {
    {{ aggregate }}::factory()->create(['name' => 'Example']);

    $response = $this->actingAs({{ variable }}ModuleAdmin())->get(route('admin.{{ slug }}.index'));

    $response->assertOk()->assertInertia(fn ($page) => $page
        ->component('{{ moduleLower }}::index', false)
        ->has('{{ variablePlural }}.data', 1)
        ->where('{{ variablePlural }}.meta.per_page', 15)
        ->where('{{ variablePlural }}.data.0.name', 'Example')
        ->where('{{ variablePlural }}.data.0.can.update', true)
        ->where('{{ variablePlural }}.data.0.can.delete', true));
});

it('applies the search filter and caps per_page', function (): void {
    $admin = {{ variable }}ModuleAdmin();
    {{ aggregate }}::factory()->create(['name' => 'Alpha']);
    {{ aggregate }}::factory()->create(['name' => 'Beta']);

    $filtered = $this->actingAs($admin)->get(route('admin.{{ slug }}.index', ['filter' => ['search' => 'Alpha']]));
    $capped = $this->actingAs($admin)->get(route('admin.{{ slug }}.index', ['per_page' => 500]));

    $filtered->assertOk()->assertInertia(fn ($page) => $page
        ->has('{{ variablePlural }}.data', 1)
        ->where('{{ variablePlural }}.data.0.name', 'Alpha'));

    $capped->assertOk()->assertInertia(fn ($page) => $page->where('{{ variablePlural }}.meta.per_page', 100));
});

it('renders the create page', function (): void {
    $this->actingAs({{ variable }}ModuleAdmin())->get(route('admin.{{ slug }}.create'))
        ->assertOk()
        ->assertInertia(fn ($page) => $page->component('{{ moduleLower }}::create', false));
});

it('stores a {{ variable }} and redirects with a success flash', function (): void {
    $response = $this->actingAs({{ variable }}ModuleAdmin())
        ->fromRoute('admin.{{ slug }}.create')
        ->post(route('admin.{{ slug }}.store'), [
            'name' => 'Example',
            'description' => 'A description.',
        ]);

    $response->assertRedirectToRoute('admin.{{ slug }}.index')
        ->assertSessionHas('success', '{{ aggregate }} created.');

    expect({{ aggregate }}::query()->where('name', 'Example')->exists())->toBeTrue();
});

it('validates the store request', function (): void {
    $this->actingAs({{ variable }}ModuleAdmin())
        ->fromRoute('admin.{{ slug }}.create')
        ->post(route('admin.{{ slug }}.store'), [])
        ->assertRedirectToRoute('admin.{{ slug }}.create')
        ->assertSessionHasErrors(['name']);
});

it('validates a single field precognitively without side effects', function (): void {
    $response = $this->actingAs({{ variable }}ModuleAdmin())
        ->withHeaders(['Precognition' => 'true', 'Precognition-Validate-Only' => 'name'])
        ->postJson(route('admin.{{ slug }}.store'), ['name' => '']);

    $response->assertStatus(422)->assertJsonValidationErrors(['name']);

    expect({{ aggregate }}::query()->count())->toBe(0);
});

it('renders the edit page', function (): void {
    ${{ variable }} = {{ aggregate }}::factory()->create(['name' => 'Example']);

    $this->actingAs({{ variable }}ModuleAdmin())->get(route('admin.{{ slug }}.edit', ${{ variable }}))
        ->assertOk()
        ->assertInertia(fn ($page) => $page
            ->component('{{ moduleLower }}::edit', false)
            ->where('{{ variable }}.id', ${{ variable }}->id)
            ->where('{{ variable }}.name', 'Example'));
});

it('updates a {{ variable }} and redirects with a success flash', function (): void {
    ${{ variable }} = {{ aggregate }}::factory()->create(['name' => 'Old']);

    $response = $this->actingAs({{ variable }}ModuleAdmin())
        ->fromRoute('admin.{{ slug }}.edit', ${{ variable }})
        ->put(route('admin.{{ slug }}.update', ${{ variable }}), [
            'name' => 'New',
            'description' => null,
        ]);

    $response->assertRedirectToRoute('admin.{{ slug }}.index')
        ->assertSessionHas('success', '{{ aggregate }} updated.');

    expect(${{ variable }}->refresh()->name)->toBe('New');
});

it('deletes a {{ variable }} and redirects with a success flash', function (): void {
    ${{ variable }} = {{ aggregate }}::factory()->create();

    $response = $this->actingAs({{ variable }}ModuleAdmin())->delete(route('admin.{{ slug }}.destroy', ${{ variable }}));

    $response->assertRedirectToRoute('admin.{{ slug }}.index')
        ->assertSessionHas('success', '{{ aggregate }} deleted.');

    expect({{ aggregate }}::query()->whereKey(${{ variable }}->id)->exists())->toBeFalse();
});

it('forbids admins without the matching permission', function (string $permission, string $method, string $routeName): void {
    Role::findByName('admin')->revokePermissionTo($permission);
    ${{ variable }} = {{ aggregate }}::factory()->create();

    $this->actingAs({{ variable }}ModuleAdmin())->{$method}(route($routeName, ${{ variable }}))->assertForbidden();
})->with([
    'create' => ['{{ slug }}.create', 'get', 'admin.{{ slug }}.create'],
    'update' => ['{{ slug }}.update', 'get', 'admin.{{ slug }}.edit'],
    'delete' => ['{{ slug }}.delete', 'delete', 'admin.{{ slug }}.destroy'],
]);
