import { Head, useForm } from '@inertiajs/react';
import { useLaravelReactI18n } from 'laravel-react-i18n';
import { FormCard } from '@/components/form-card';
import { useBreadcrumbs } from '@/hooks/use-breadcrumbs';
import { edit, index, update } from '@/routes/admin/{{ slug }}';
import type { {{ aggregate }}Row } from '../components/{{ aggregateKebab }}-columns';
import { {{ aggregate }}FormFields } from '../components/{{ aggregateKebab }}-form-fields';
import type { {{ aggregate }}FormData } from '../components/{{ aggregateKebab }}-form-fields';

type {{ plural }}EditProps = {
    {{ variable }}: {{ aggregate }}Row;
};

export default function {{ plural }}Edit({ {{ variable }} }: {{ plural }}EditProps) {
    const { t } = useLaravelReactI18n();

    useBreadcrumbs(
        { title: t('{{ label }}'), href: index() },
        { title: {{ variable }}.name, href: edit({{ variable }}.id) },
    );

    const form = useForm<{{ aggregate }}FormData>(update({{ variable }}.id), {
        name: {{ variable }}.name,
        description: {{ variable }}.description ?? '',
    });

    return (
        <>
            <Head title={t('Edit :name', { name: {{ variable }}.name })} />
            <FormCard
                title={t('Edit {{ variable }}')}
                description={t('Update the {{ variable }} details.')}
                onSubmit={() => form.submit({ preserveScroll: true })}
                processing={form.processing}
                submitLabel={t('Save changes')}
                cancelHref={index()}
            >
                <{{ aggregate }}FormFields
                    form={form}
                />
            </FormCard>
        </>
    );
}
