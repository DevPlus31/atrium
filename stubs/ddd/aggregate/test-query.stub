<?php

declare(strict_types=1);

use Modules\{{ module }}\Infrastructure\Models\{{ aggregate }};
use Modules\{{ module }}\Queries\{{ plural }}IndexQuery;

it('searches by name', function (): void {
    {{ aggregate }}::factory()->create(['name' => 'Blue widget']);
    {{ aggregate }}::factory()->create(['name' => 'Red gadget']);

    $names = indexQuery({{ plural }}IndexQuery::class, ['filter' => ['search' => 'widget']])->builder()->pluck('name')->all();

    expect($names)->toBe(['Blue widget']);
});

it('sorts by name and defaults to the newest first', function (): void {
    {{ aggregate }}::factory()->create(['name' => 'Bravo', 'created_at' => now()->subDay()]);
    {{ aggregate }}::factory()->create(['name' => 'Alpha', 'created_at' => now()]);

    $byName = indexQuery({{ plural }}IndexQuery::class, ['sort' => '-name']);
    $byDefault = indexQuery({{ plural }}IndexQuery::class);

    expect($byName->builder()->pluck('name')->all())->toBe(['Bravo', 'Alpha'])
        ->and($byDefault->builder()->pluck('name')->all())->toBe(['Alpha', 'Bravo']);
});
