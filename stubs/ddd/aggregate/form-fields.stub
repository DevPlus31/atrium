import { useLaravelReactI18n } from 'laravel-react-i18n';
import { TextField } from '@/components/text-field';
import type { FormFieldsProps } from '@/types';

/**
 * The editable fields, taken from the generated DTO type. The form holds an
 * empty string for "no description" (inputs need a string).
 */
export type {{ aggregate }}FormData = Pick<
    Modules.{{ module }}.Data.{{ aggregate }}Data,
    'name'
> & { description: string };

/** The {{ variable }} fields shared by the create and edit forms. */
export function {{ aggregate }}FormFields({
    form,
    autoFocus = false,
}: FormFieldsProps<{{ aggregate }}FormData> & { autoFocus?: boolean }) {
    const { t } = useLaravelReactI18n();

    return (
        <>
            <TextField
                form={form}
                name="name"
                label={t('Name')}
                autoFocus={autoFocus}
                autoComplete="off"
            />

            <TextField
                form={form}
                name="description"
                rows={4}
                label={t('Description')}
            />
        </>
    );
}
