APP_NAME=Atrium
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Load balancer / reverse proxy IPs or CIDRs (comma separated), or * — empty when clients connect directly
TRUSTED_PROXIES=

# Modules switched off for everyone, by name (e.g. shop,catalog)
MODULES_DISABLED=

# Where uploads (profile photos, logos…) are stored: public (default) or s3
MEDIA_DISK=public

# Secret for passkey user handles. Set it once and never change it: unlike
# APP_KEY (its fallback), rotating it breaks every registered passkey.
PASSKEYS_USER_HANDLE_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# PostgreSQL, as in production and CI:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=atrium
# DB_USERNAME=atrium
# DB_PASSWORD=

# Keep "database": Settings → Sessions lists and signs out devices from it.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Over HTTPS in production: SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
